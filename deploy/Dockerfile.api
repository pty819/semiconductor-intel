# API / worker / scheduler image. Build from the repo root:
#   docker compose -f deploy/compose.yaml build api
#
# NOOA arrives as a git dependency (pinned commit in pyproject.toml /
# uv.lock) — no extra build context needed.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/root/.local/bin:$PATH"

# git: uv needs it to resolve the NOOA git dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates build-essential git \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh

WORKDIR /app

COPY pyproject.toml uv.lock README.md alembic.ini /app/
COPY src /app/src
COPY migrations /app/migrations

RUN uv sync --frozen --no-dev

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8000
CMD ["uvicorn", "intel.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
