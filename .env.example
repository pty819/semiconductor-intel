# semiconductor-intel environment template.
# Copy to .env and fill in values. Secrets stay in env, never in git.

# -- database (default: 82, container semiconductor-intel-pg; smoke passed) --
# INTEL_DATABASE_URL=postgresql+asyncpg://postgres:${PG_PASSWORD}@192.168.1.82:5432/postgres
# PG_PASSWORD=
# INTEL_TEST_DATABASE_URL=postgresql+asyncpg://postgres:${PG_PASSWORD}@192.168.1.82:5432/postgres

# Optional NAS (192.168.1.21) — HOST= docs in deploy/postgres/README.md only.
# INTEL_DATABASE_URL=postgresql+asyncpg://postgres:${PG_PASSWORD}@192.168.1.21:5433/postgres

# Local compose profile `local-db`:
# INTEL_DATABASE_URL=postgresql+asyncpg://postgres:${PG_PASSWORD}@postgres:5432/postgres

# -- objects / sessions ------------------------------------------------------
# INTEL_OBJECT_STORE_ROOT=var/objects
# INTEL_SESSION_PEPPER=

# -- OpenAI-v1 LLM (no grok-* model literals in committed defaults) ----------
# Debug endpoint on 82 llamacpp. Set model ids from GET /v1/models
# (Bonsai-27B gguf id) in src/intel/nooa_adapter/registry/routes.yaml.
# INTEL_LLM_BASE_URL=http://192.168.1.82:8080/v1
# INTEL_LLM_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=http://192.168.1.82:8080/v1

# Optional grok2api OpenAI-v1 gateway (still no grok-* names in yaml):
# INTEL_LLM_BASE_URL=http://192.168.1.21:8000/v1
# INTEL_GROK2API_BASE_URL=http://192.168.1.21:8000/v1
# INTEL_GROK2API_KEY=
# GROK2API_BASE_URL=http://192.168.1.21:8000/v1
# GROK2API_KEY=

# -- investigation gateway (fail-closed when empty) --------------------------
# INTEL_GATEWAY_SECRET=

# -- knobs -------------------------------------------------------------------
# INTEL_LLM_CONCURRENCY=4
# INTEL_FETCH_CONCURRENCY=8
# INTEL_SEARCH_BACKFILL_DAYS=90

# -- compose / image build ---------------------------------------------------
# NOOA is a git dependency pinned in pyproject.toml — nothing to set for it.
# HTTP_PORT=80
